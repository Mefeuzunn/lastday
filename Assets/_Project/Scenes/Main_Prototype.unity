  m_Script: {fileID: 11500000, guid: ccc3888f2d75446a1ae80e437d1afdee, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ProjectSurvival.Narrative.AudioLogInteractable
  objectTitle: "Kay\u0131t #04 \u2014 Trafo Sabotaj\u0131"
  objectSubtitle: "M\xFChendis Kemal"
  persistentId: 
  hasBeenSearched: 0
  isOpen: 0
  isBarricaded: 0
  isPowered: 0
  isDamaged: 0
  enableFocusHighlight: 1
  focusEmissionColor: {r: 0.35, g: 0.28, b: 0.08, a: 1}
  logId: log_substation_sabotage
  speakerName: "M\xFChendis Kemal"
  transcriptText: "\u015Eehir \u015Febekesi a\u015F\u0131r\u0131 y\xFCklendi. Birileri
    karantina bariyerlerinin elektri\u011Fini kasten kesti. Trafo merkezindeki ana
    jenerat\xF6rleri devre d\u0131\u015F\u0131 b\u0131rakt\u0131lar. E\u011Fer b\xF6lgesel
    \u015Febeke panellerini birle\u015Ftiremezsek t\xFCm \u015Fehir karanl\u0131\u011Fa
    g\xF6m\xFClecek."
  cyanLedLight: {fileID: 0}
  ledMeshRenderer: {fileID: 0}
  cyanGlowColor: {r: 0, g: 0.94, b: 1, a: 1}
