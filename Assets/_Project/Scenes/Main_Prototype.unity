  m_EditorClassIdentifier: Assembly-CSharp::ProjectSurvival.Narrative.AudioLogInteractable
  objectTitle: "Kay\u0131t #06 \u2014 Ormandaki Mutasyonlar"
  objectSubtitle: Korucu Berk
  persistentId: 
